# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# Required for every API endpoint except /health (sent as the X-API-Key header). Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/investment_agent

# --- Data providers ---
# Live sources (real NSE/BSE companies):
#   UNIVERSE_PROVIDER=nse_bse             NSE main-board list + BSE-only companies (merged by ISIN)
#   FUNDAMENTALS_PROVIDER=screener         Screener.in company pages (secondary source; check its terms)
#   MARKET_DATA_PROVIDER=exchange_bhavcopy NSE/BSE daily price files synced into Postgres
#   ANNOUNCEMENTS_PROVIDER=nse             NSE announcements, board meetings, pledge data
# Offline alternatives: fixture (SYNTHETIC sample market), local_files (your own files), nse_csv (universe).
UNIVERSE_PROVIDER=nse_bse
FUNDAMENTALS_PROVIDER=screener
MARKET_DATA_PROVIDER=exchange_bhavcopy
ANNOUNCEMENTS_PROVIDER=nse
# Sent with every request so site operators can see who is calling. Never set this to a browser string.
HTTP_USER_AGENT=investment-agent/0.1 (personal research tool; low-volume)
HTTP_MIN_INTERVAL_SECONDS=2.0
SCREENER_MIN_INTERVAL_SECONDS=3.0
SCREENER_CACHE_HOURS=72
# NSE first; set true once you want BSE-only companies too (duplicates are merged by ISIN)
INCLUDE_BSE_ONLY=false
# Exchanges whose daily price files are synced: NSE, BSE (BSE files are ~1 MB/day)
PRICE_SYNC_EXCHANGES=["NSE"]
# ~1 year of prices; ~1100 enables history-relative P/E
PRICE_BACKFILL_DAYS=400
# LOCAL_DATA_DIR=./data/local
# Use a manually downloaded copy instead of fetching from NSE:
# NSE_EQUITY_LIST_PATH=./data/local/EQUITY_L.csv

# --- LLM ---
# Without a key, reports are still produced from deterministic data only (status "partial").
LLM_ENABLED=true
# openai | anthropic
LLM_PROVIDER=openai
PROMPT_VERSION=v2

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# none | minimal | low | medium | high | xhigh; leave EMPTY for non-reasoning models such as gpt-4o-mini
OPENAI_REASONING_EFFORT=medium

# Anthropic (only if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_REFUSAL_FALLBACK=true

# --- Notifications: JSON list of log | telegram | email ---
NOTIFICATION_CHANNELS=["log"]
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
ALERT_QUIET_PERIOD_HOURS=72
REPORT_BASE_URL=http://localhost:8000

# --- Worker schedules (cron, evaluated in SCHEDULER_TIMEZONE) ---
SCHEDULER_TIMEZONE=Asia/Kolkata
WEEKLY_SCREENING_CRON=0 7 * * sun
DAILY_MONITORING_CRON=30 19 * * mon-fri
RESEARCH_QUEUE_CRON=*/30 * * * *
ALERT_RETRY_CRON=*/15 * * * *
PRICE_SYNC_CRON=30 19 * * mon-fri
EVENT_DISCOVERY_CRON=0 21 * * mon-fri
RESEARCH_BATCH_SIZE=5
